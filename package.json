{
	"name": "hi-note",
	"version": "0.5.9",
	"description": "Enhance your highlighted notes with comment management and export features.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:i18n": "node scripts/test-i18n.cjs",
		"test:review": "node scripts/test-review-regressions.cjs",
		"test:flashcards": "node scripts/test-flashcard-learning.cjs",
		"test:storage": "node scripts/test-storage-safety.cjs",
		"test:colors": "node scripts/test-highlight-colors.cjs",
		"test:matching": "node scripts/test-highlight-matching.cjs",
		"test:navigation": "node scripts/test-navigation.cjs",
		"test:favorites": "node scripts/test-favorites.cjs",
		"test:models": "node scripts/test-highlight-models.cjs",
		"test:views": "node scripts/test-view-state.cjs",
		"test:hicard-view": "node scripts/test-hicard-view.cjs",
		"test:exclusions": "node scripts/test-exclusions.cjs",
		"test:secrets": "node scripts/test-ai-secrets.cjs",
		"test:ai": "node scripts/test-ai-connections.cjs"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "^0.25.0",
		"obsidian": "1.13.1",
		"tslib": "2.4.0",
		"typescript": "^4.7.4"
	},
	"dependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"html2canvas": "^1.4.1",
		"ts-fsrs": "5.4.2"
	}
}
